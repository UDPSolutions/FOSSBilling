# deploy.sh settings — copy to deploy.env (gitignored) and fill in for your host.
# Sourced by bash: KEY="value", no spaces around "=".

# SSH
SSH_KEY="$HOME/.ssh/your_deploy_key"
VPS="root@billing.example.com"

# Public URL (used for the post-deploy HTTP checks)
SITE="https://billing.example.com"

# Server paths
LIVE_DIR="/var/www/fossbilling"            # what nginx serves
BUILD_DIR="/var/www/fossbilling-build"     # staging dir; vendor/ is built here
BACKUP_DIR="/root/backups"                 # code tarball + DB dump before each deploy

# Runtime identity
APP_USER="fossbilling"                     # PHP-FPM pool user; owns the code
DB_NAME="fossbilling"                      # dumped before deploy (root's MySQL socket auth)

# PHP on the server
PHP_BIN="php8.4"
PHP_FPM_SERVICE="php8.4-fpm"               # reloaded after sync to clear opcache
COMPOSER_BIN="/usr/local/bin/composer"
